# Non-secret, fail-closed knowledge-ingestion runtime defaults.
INGEST_CONCURRENCY_MODE=adaptive
INGEST_NAS_READ_INITIAL=4
INGEST_NAS_READ_HARD_MAX=12
INGEST_MINERU_SUBMIT_INITIAL=4
INGEST_MINERU_SUBMIT_HARD_MAX=8
INGEST_MINERU_POLL_INITIAL=8
INGEST_MINERU_POLL_HARD_MAX=32
INGEST_MINERU_POLL_BASE_SECONDS=2
INGEST_MINERU_POLL_MAX_SECONDS=30
INGEST_MINERU_POLL_JITTER_RATIO=0.20
INGEST_EMBEDDING_INITIAL=16
INGEST_EMBEDDING_HARD_MAX=24
INGEST_LIGHTRAG_INSERT_INITIAL=6
INGEST_LIGHTRAG_INSERT_HARD_MAX=16
INGEST_RERANKER_INITIAL=8
INGEST_RERANKER_HARD_MAX=24
INGEST_LLM_INTERACTIVE_INITIAL=4
INGEST_LLM_INTERACTIVE_HARD_MAX=8
INGEST_LLM_INTERACTIVE_RESERVED=2
INGEST_LLM_BULK_INITIAL=4
INGEST_LLM_BULK_HARD_MAX=12
INGEST_LLM_SHARED_HARD_MAX=16
INGEST_METADATA_QUEUE_MAX=10000
INGEST_SELECTION_QUEUE_MAX=1000
INGEST_PARSE_QUEUE_MAX=100
INGEST_INSERT_QUEUE_MAX=500
INGEST_SPOOL_MAX_BYTES=8589934592
INGEST_SPOOL_MAX_OBJECT_BYTES=1073741824
INGEST_SPOOL_MAX_ACTIVE=4
INGEST_MINIMUM_FREE_BYTES=34359738368
INGEST_HARD_STOP_FREE_BYTES=27917287424
INGEST_DERIVED_TARGET_BYTES=80530636800
INGEST_DERIVED_HARD_CAP_BYTES=85899345920
INGEST_FILESYSTEM_ALERT_RATIO=0.75
INGEST_FILESYSTEM_STOP_RATIO=0.80

# Native LightRAG v1.5.4 bindings; credentials are supplied only by *_FILE secrets.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=true
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_USE_BASE64=true
EMBEDDING_ASYMMETRIC=true
EMBEDDING_DOCUMENT_PREFIX=NO_PREFIX
EMBEDDING_QUERY_PREFIX=为材料科学研究问题检索包含可核验材料组成、制备工艺、测试条件、性能值和来源定位的证据段落。查询：
EMBEDDING_BATCH_NUM=32
EMBEDDING_FUNC_MAX_ASYNC=32
EMBEDDING_TIMEOUT=90
RERANK_BINDING=cohere
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BY_DEFAULT=true
MIN_RERANK_SCORE=0.0
RERANK_ENABLE_CHUNKING=false
MAX_ASYNC_RERANK=8
RERANK_TIMEOUT=30

# PostgreSQL-backed LightRAG storage is mandatory in production.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
WORKSPACE=glm-embedding-3-1024-halfvec-v1
POSTGRES_WORKSPACE=glm-embedding-3-1024-halfvec-v1
POSTGRES_VECTOR_INDEX_TYPE=HNSW_HALFVEC
