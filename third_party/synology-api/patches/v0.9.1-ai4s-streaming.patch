+class TestAuthenticationStreaming(unittest.TestCase):
+    """Tests for unbuffered requests on the authenticated session."""
+
+    def test_request_stream_reuses_session_and_preserves_relay_headers(self):
+        auth = _make_auth()
+        auth._quickconnect_headers = {
+            'Origin': 'https://nas.quickconnect.to',
+            'Referer': 'https://nas.quickconnect.to',
+        }
+        session = MagicMock()
+        response = MagicMock()
+        session.get.return_value = response
+        auth._requests_session = session
+        params = {'version': 2, 'method': 'download', 'preview': True}
+
+        result = auth.request_stream(
+            'SYNO.FileStation.Download',
+            'entry.cgi',
+            params,
+            headers={
+                'Range': 'bytes=3-',
+                'Origin': 'https://invalid.example',
+                'Referer': 'https://invalid.example',
+            },
+            timeout=(2.0, 30.0),
+        )
+
+        self.assertIs(result, response)
+        self.assertEqual(
+            session.get.call_args.args[0],
+            'http://nas:5000/webapi/entry.cgi?api=SYNO.FileStation.Download',
+        )
+        self.assertEqual(
+            session.get.call_args.kwargs['params'],
+            {
+                'version': 2,
+                'method': 'download',
+                'preview': 'true',
+                '_sid': 'sid',
+            },
+        )
+        self.assertEqual(
+            session.get.call_args.kwargs['headers'],
+            {
+                'Origin': 'https://nas.quickconnect.to',
+                'Referer': 'https://nas.quickconnect.to',
+                'X-SYNO-TOKEN': 'token',
+                'Range': 'bytes=3-',
+            },
+        )
+        self.assertTrue(session.get.call_args.kwargs['stream'])
+        self.assertEqual(session.get.call_args.kwargs['timeout'], (2.0, 30.0))
+        self.assertEqual(
+            params,
+            {'version': 2, 'method': 'download', 'preview': True},
+        )
+        response.close.assert_not_called()
+        response.raise_for_status.assert_not_called()
+
