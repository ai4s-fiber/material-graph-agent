+    def request_stream(self,
+                       api_name: str,
+                       api_path: str,
+                       req_param: dict[str, object],
+                       method: str = 'get',
+                       data: Any = None,
+                       headers: Optional[dict[str, object]] = None,
+                       timeout: Optional[
+                           Union[float, tuple[float, float]]
+                       ] = None,
+                       ) -> requests.Response:
+        """Open a streaming DSM response on the authenticated HTTP session.
+
+        The response body is never decoded or buffered by this method.  The
+        caller owns the returned response and must always call ``close()``.
+        QuickConnect relay cookies and Origin/Referer headers are preserved by
+        reusing the session created during relay discovery.
+
+        Parameters
+        ----------
+        api_name : str
+            DSM API name, for example ``SYNO.FileStation.Download``.
+        api_path : str
+            API endpoint path returned by ``SYNO.API.Info``.
+        req_param : dict
+            Request parameters. The caller's dictionary is not modified.
+        method : str, optional
+            HTTP method, either ``get`` or ``post``. Defaults to ``get``.
+        data : object, optional
+            Optional POST body.
+        headers : dict, optional
+            Additional headers such as ``Range``.
+        timeout : float or tuple, optional
+            Requests connect/read timeout.
+
+        Returns
+        -------
+        requests.Response
+            An open response configured with ``stream=True``.
+        """
+        normalized_method = method.lower()
+        if normalized_method not in ('get', 'post'):
+            raise ValueError("Unsupported request method: %s" % method)
+
+        params = {
+            key: str(value).lower() if isinstance(value, bool) else value
+            for key, value in req_param.items()
+        }
+        params['_sid'] = self._sid
+        url = ('%s%s' % (self._base_url, api_path)) + '?api=' + api_name
+        request_headers = self._get_request_headers(headers)
+        request_options = {
+            'verify': self._verify,
+            'headers': request_headers,
+            'stream': True,
+        }
+        if timeout is not None:
+            request_options['timeout'] = timeout
+
+        if self._requests_session is None:
+            self._requests_session = requests.Session()
+
+        try:
+            if normalized_method == 'get':
+                return self._get(url, params, **request_options)
+            if data is None:
+                return self._post(url, params, **request_options)
+            upload_url = ('%s%s' % (self._base_url, api_path)) + '/' + api_name
+            return self._post(
+                upload_url,
+                data=data,
+                params=params,
+                **request_options,
+            )
+        except requests.exceptions.ConnectionError as e:
+            raise SynoConnectionError(error_message=e.args[0])
+
