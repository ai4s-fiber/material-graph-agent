+class TestAuthenticationLogoutCleanup(unittest.TestCase):
+    """Tests that logout always destroys local authentication state."""
+
+    @staticmethod
+    def _logged_in_auth(response=None):
+        auth = _make_auth()
+        auth._noise_connection = FakeNoiseConnection()
+        auth._noise_handshake_hash = 'handshake'
+        auth._quickconnect_headers = {'Origin': 'relay'}
+        session = MagicMock()
+        if response is not None:
+            session.get.return_value = response
+        auth._requests_session = session
+        return auth, session
+
+    def assert_logged_out(self, auth, session):
+        self.assertIsNone(auth.sid)
+        self.assertIsNone(auth.syno_token)
+        self.assertIsNone(auth._noise_connection)
+        self.assertIsNone(auth._noise_handshake_hash)
+        self.assertIsNone(auth._requests_session)
+        self.assertEqual(auth._quickconnect_headers, {})
+        self.assertTrue(auth._session_expire)
+        session.close.assert_called_once_with()
+
+    def test_logout_success_clears_and_closes_everything(self):
+        response = MagicMock()
+        response.json.return_value = {'success': True}
+        auth, session = self._logged_in_auth(response)
+
+        auth.logout()
+
+        self.assert_logged_out(auth, session)
+
+    def test_logout_connection_failure_still_clears_and_closes(self):
+        auth, session = self._logged_in_auth()
+        session.get.side_effect = requests.exceptions.ConnectionError(
+            'offline')
+
+        with self.assertRaises(SynoConnectionError):
+            auth.logout()
+
+        self.assert_logged_out(auth, session)
+
+    def test_logout_api_failure_still_clears_and_closes(self):
+        response = MagicMock()
+        response.json.return_value = {'success': False, 'error': {'code': 105}}
+        auth, session = self._logged_in_auth(response)
+
+        with self.assertRaises(LogoutError):
+            auth.logout()
+
+        self.assert_logged_out(auth, session)
+
+    def test_session_close_failure_cannot_retain_local_secrets(self):
+        response = MagicMock()
+        response.json.return_value = {'success': True}
+        auth, session = self._logged_in_auth(response)
+        session.close.side_effect = RuntimeError('close failed')
+
+        auth.logout()
+
+        self.assertIsNone(auth.sid)
+        self.assertIsNone(auth.syno_token)
+        self.assertIsNone(auth._requests_session)
+
+
